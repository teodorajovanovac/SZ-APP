<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- PdfSharpCore: MIT licensed fork of PDFsharp, pure managed deps (SixLabors.ImageSharp/Fonts),
         no revenue-gated license (chosen over QuestPDF's Community-license revenue threshold). -->
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <!-- Pin transitive SixLabors.ImageSharp to the last Apache-2.0 2.x release with CVE fixes
         (PdfSharpCore's own dependency, 1.0.4, has known high-severity CVEs; v3+ is dual-licensed
         commercial, so staying on 2.x keeps this permissive). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\DejaVuSans.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SzApp.Contracts\SzApp.Contracts.csproj" />
    <ProjectReference Include="..\SzApp.Data\SzApp.Data.csproj" />
    <ProjectReference Include="..\SzApp.Domain\SzApp.Domain.csproj" />
    <ProjectReference Include="..\SzApp.Etl\SzApp.Etl.csproj" />
  </ItemGroup>

</Project>
