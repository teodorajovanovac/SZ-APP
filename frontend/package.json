    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-table": "^8.21.3",
    "i18next": "^25.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.8"
